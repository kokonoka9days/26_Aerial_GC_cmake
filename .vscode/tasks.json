{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build firmware (make.sh)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/make.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Download firmware (downloads.sh)",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/downloads.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
